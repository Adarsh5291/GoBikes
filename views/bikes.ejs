<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Browse Bikes - Rathika</title>>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <h1>Available Bikes</h1>

    <div>
        <a href="/bikes">All</a>
        <a href="/bikes?type=Sports">Sports</a>
        <a href="/bikes?type=Classic">Classic</a>
        <a href="/bikes?type=Cruiser">Cruiser</a>
        <a href="/bikes?type=Adventure">Adventure</a>
        <a href="/bikes?type=Scooter">Scooter</a>
        <a href="/bikes?type=Other">Other</a>
    </div>

    <hr>

    <% if (bikes.length === 0) { %>

        <p>No bikes found for this category.</p>

    <% } else { %>

        <% bikes.forEach(bike => { %>

            <div>
                <h2>
                    <a href="/bikes/<%= bike._id %>">
                        <%= bike.name %>
                    </a>
                </h2>

                <p>Brand: <%= bike.brand %></p>

                <p>Type: <%= bike.type %></p>

                <p>₹<%= bike.pricePerDay %> / day</p>

                <p><%= bike.description %></p>
            </div>

            <hr>

        <% }) %>

    <% } %>

</body>
</html>